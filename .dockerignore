# Docker最適化設定
# 開発・テスト関連ファイルを除外してデプロイサイズを大幅削減

# Python関連
*.pyc
*.pyo
*.pyd
__pycache__/
.pytest_cache/
.coverage
.tox/

# 開発ツール
.git/
.gitignore
.vscode/
.idea/

# ドキュメント
*.md
README*
CHANGELOG*
LICENSE*

# テスト・デバッグファイル
test_*.py
*_test.py
tests/
debug_*.py
analyze_*.py
check_*.py
diagnose_*.py
investigate_*.py
fix_*.py
temp_*.py
dummy_*.py
simple_*.py

# バックアップ・一時ファイル
*.bak
*.tmp
*.temp
backup/
temp/
nul
output.txt

# データベース開発ファイル
*.db
*.sqlite
*.sql
dump.sql

# 設定・スクリプトファイル
*.bat
*.ps1
*.sh
setup.py
alembic.ini

# 依存関係
# requirements.txt  # <- 本番デプロイで必要なので除外しない
temp_requirements.txt

# その他の開発ファイル
create_*.py
add_*.py
migrate_*.py
restore_*.py
clean_*.py
list_*.py
renumber_*.py
start_*.py
match_setup.py
modules_cleanup.py
gradient_demo.py
manual_test.py

# フォント（必要に応じて）
*.ttf
*.otf

# 重要ファイルを明示的に含める（Railwayデプロイ対応）
!requirements.txt
!CHANGELOG.md
!README.md
!CALCULATION_LOGIC.md
