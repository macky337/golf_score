# Application login (required)
APP_USERNAME=member
APP_PASSWORD=replace-with-a-long-random-password

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-service-role-key

# Separate password for destructive administrator functions
ADMIN_PASSWORD=replace-with-another-long-random-password
